{
  "name": "@kinesthesia/studio",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "ensure-electron": "bun scripts/ensure-electron.ts",
    "build:main": "bun build src/main.ts --target=node --format=cjs --external electron --outfile dist/main.cjs",
    "dev": "bun run ensure-electron && bun run build:main && electron dist/main.cjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "44.3.0"
  },
  "trustedDependencies": [
    "electron"
  ]
}
