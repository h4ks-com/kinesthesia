{
  "name": "@kinesthesia/studio",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "ensure-electron": "bun scripts/ensure-electron.ts",
    "build:main": "bun build src/main.ts --target=node --format=cjs --external electron --outfile dist/main.cjs",
    "stage:web": "bun scripts/stage-web.ts",
    "dev": "bun run ensure-electron && bun run build:main && electron dist/main.cjs",
    "package": "bun run build:main && bun run stage:web && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "trustedDependencies": [
    "electron"
  ]
}
